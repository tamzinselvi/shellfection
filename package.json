{
  "name": "shellfection",
  "version": "1.0.7",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.13.0",
  "author": "tomselvi",
  "scripts": {
    "build": "eslint src && babel --out-dir lib src",
    "test": "npm run build && jest --runInBand",
    "start": "watch 'npm run test' src",
    "prepare": "npm run build"
  },
  "bin": {
    "shellfection": "./bin/shellfection",
    "shellfection-cube": "./bin/shellfection-cube",
    "shellfection-game-of-life": "./bin/shellfection-game-of-life",
    "shellfection-mpv-playlist": "./bin/shellfection-mpv-playlist",
    "shellfection-screensavers": "./bin/shellfection-screensavers",
    "shellfection-welcome": "./bin/shellfection-welcome",
    "pipeseroni-pipes": "./bin/pipeseroni-pipes"
  },
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "transform": {
      "^.+\\.js$": "babel-jest"
    }
  },
  "dependencies": {
    "cli-spinner": "^0.2.7",
    "colors": "^1.1.2",
    "command-exists": "^1.2.8",
    "commander": "^2.12.2",
    "fs-extra": "^7.0.0",
    "gists": "^2.0.0",
    "lodash": "^4.17.11",
    "sharp": "^0.34.2",
    "user-home": "^2.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.27.2",
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "babel-jest": "^30.0.0",
    "eslint": "^9.28.0",
    "jest": "^30.0.0"
  },
  "bugs": {
    "url": "https://github.com/tomselvi/shellfection/issues"
  },
  "homepage": "https://github.com/tomselvi/shellfection#readme",
  "directories": {
    "lib": "lib"
  },
  "keywords": [
    "shellfection",
    "tmux",
    "neovim",
    "zsh"
  ]
}
